{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandos.local/schemas/auth-boundary.schema.json",
  "title": "Auth Boundary",
  "type": "object",
  "required": ["id", "name", "status", "subjects", "protectedObjects", "decisions", "constraints"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "subjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protectedObjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
