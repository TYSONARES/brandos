{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandos.local/schemas/test-strategy.schema.json",
  "title": "Test Strategy",
  "type": "object",
  "required": ["id", "name", "status", "scope", "requiredChecks", "evidence"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "scope": { "type": "string" },
    "requiredChecks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
