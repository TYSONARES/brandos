{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandos.local/schemas/secret-policy.schema.json",
  "title": "Secret Policy",
  "type": "object",
  "required": ["id", "name", "status", "scope", "storageRule", "rotationRule", "constraints"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "scope": { "type": "string" },
    "storageRule": { "type": "string" },
    "rotationRule": { "type": "string" },
    "constraints": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
