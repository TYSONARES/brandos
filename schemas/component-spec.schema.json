{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandos.local/schemas/component-spec.schema.json",
  "title": "Component Spec",
  "type": "object",
  "required": ["id", "name", "status", "purpose", "productObjects", "states", "accessibility", "tokens"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "purpose": { "type": "string" },
    "productObjects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accessibility": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tokens": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
