{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandos.local/schemas/integration-boundary.schema.json",
  "title": "Integration Boundary",
  "type": "object",
  "required": ["id", "name", "status", "direction", "ownedBy", "dataShared", "constraints"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
    "ownedBy": { "type": "string" },
    "dataShared": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
